<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The only SQL dependency (MIT). Never DacFx: see CONTRIBUTING.md. -->
    <PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <!-- xunit v3 runs on Microsoft.Testing.Platform (opted into in global.json), so neither
         Microsoft.NET.Test.Sdk nor the VSTest adapter is needed. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
