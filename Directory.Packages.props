<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The only SQL dependency (MIT). Never DacFx: see CONTRIBUTING.md. -->
    <PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>
  <ItemGroup Label="Build">
    <!-- The compiler's API (MIT), for the analyser in analysers/ that checks switches over closed hierarchies; build time
         only, so nothing of it ships. Not newer than the compiler of the SDK in global.json, which loads the analyser. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <!-- xunit v3 runs on Microsoft.Testing.Platform (opted into in global.json), so neither
         Microsoft.NET.Test.Sdk nor the VSTest adapter is needed. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- Differential tests only (MIT, both): see CONTRIBUTING.md. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <!-- Not used directly. SqlClient 7.1.1 brings 9.0.18, which has two denial-of-service advisories
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7), so the patched version is referenced explicitly. Drop this
         once SqlClient depends on a patched version itself. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Tests only: Microsoft's master.dacpac, read by OtherDatabasesTests to show the hand-written stand-in has its shape.
         Microsoft's licence lets it be used to develop and test, not redistributed, so it is only restored (its hash pinned in
         the lock file), never committed or copied into the repository. -->
    <PackageVersion Include="Microsoft.SqlServer.Dacpacs.Master" Version="170.0.4" />
  </ItemGroup>
</Project>
