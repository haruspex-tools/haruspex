{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sharpblue/haruspex/raw/main/schemas/haruspex.ir.schema.json",
  "title": "haruspex.ir.json",
  "description": "An IR file of version 0.24 or 0.23: the shapes haruspex inferred for a set of database objects, of one database or (0.24) combining two. The format is described in src/Haruspex.Ir/README.md.",
  "type": "object",
  "properties": {
    "irVersion": {
      "description": "The IR's version, which a reader checks before anything else: 0.24 for a document combining two databases, 0.23 for one of one database.",
      "enum": [
        "0.24",
        "0.23"
      ]
    },
    "source": {
      "description": "Where the shapes were inferred from.",
      "type": "object",
      "properties": {
        "dialect": {
          "description": "The SQL dialect, such as tsql.",
          "type": "string"
        },
        "package": {
          "description": "The file name of the package the source was read from, such as a DACPAC. Left out for a source that is not a package.",
          "type": "string"
        },
        "sha256": {
          "description": "The SHA-256 of the package's bytes. Given exactly when package is.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "references": {
          "description": "The packages the package refers to, found or not, sorted by name and then database. Left out when there are none.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/packageReference"
          }
        },
        "session": {
          "description": "The options the callers' sessions are declared to set, by the dialect's name for each: true for on, false for off. Left out when none is declared.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "baseline": {
          "description": "For a document combining two databases (0.24), where the other, the baseline, was read from. Given exactly when irVersion is 0.24.",
          "type": "object",
          "properties": {
            "dialect": {
              "description": "The SQL dialect, such as tsql.",
              "type": "string"
            },
            "package": {
              "description": "The file name of the package the source was read from, such as a DACPAC. Left out for a source that is not a package.",
              "type": "string"
            },
            "sha256": {
              "description": "The SHA-256 of the package's bytes. Given exactly when package is.",
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "references": {
              "description": "The packages the package refers to, found or not, sorted by name and then database. Left out when there are none.",
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/packageReference"
              }
            },
            "session": {
              "description": "The options the callers' sessions are declared to set, by the dialect's name for each: true for on, false for off. Left out when none is declared.",
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "boolean"
              }
            }
          },
          "required": [
            "dialect"
          ],
          "additionalProperties": false,
          "dependentRequired": {
            "package": [
              "sha256"
            ],
            "sha256": [
              "package"
            ]
          }
        }
      },
      "required": [
        "dialect"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "package": [
          "sha256"
        ],
        "sha256": [
          "package"
        ]
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "types": {
      "description": "The named object types, by name.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/objectType"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/override"
      }
    },
    "folds": {
      "description": "The folds the canonical value sets name, by name: how a collation compares a column's strings (0.20).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/fold"
      }
    }
  },
  "required": [
    "irVersion",
    "source",
    "objects",
    "types",
    "unknowns",
    "overrides",
    "folds"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "irVersion": {
          "const": "0.23"
        },
        "source": {
          "not": {
            "required": [
              "baseline"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "irVersion": {
          "const": "0.24"
        },
        "source": {
          "required": [
            "baseline"
          ]
        }
      }
    }
  ],
  "$defs": {
    "packageReference": {
      "description": "A package the source's package refers to.",
      "type": "object",
      "properties": {
        "package": {
          "description": "Its file name, as the referring package names it.",
          "type": "string"
        },
        "sha256": {
          "description": "The SHA-256 of the package read for it; left out when none was found.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "database": {
          "description": "Left out for the same database; otherwise the other database, by name or SQLCMD variable, as the reference names it.",
          "type": "string"
        }
      },
      "required": [
        "package"
      ],
      "additionalProperties": false
    },
    "object": {
      "description": "A typed object: a procedure of the database, or a query file of the application.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Its identity: a procedure's name in the database, or a query file's path relative to its config file's folder.",
          "type": "string"
        },
        "name": {
          "description": "The name settled for generated code.",
          "type": "string"
        },
        "kind": {
          "enum": [
            "procedure",
            "query"
          ]
        },
        "at": {
          "description": "Where it is defined, as path:line:column.",
          "type": "string"
        },
        "text": {
          "description": "What a query runs, as one batch, with LF line endings; only a query has it, and a query always does.",
          "type": "string"
        },
        "returnsCode": {
          "description": "Whether a call may end with a return code other than 0.",
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "results": {
          "description": "Its result sets in order, or null when they cannot be listed; named all or none.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": true
                },
                "required": [
                  "name"
                ],
                "$ref": "#/$defs/result"
              }
            },
            {
              "type": "array",
              "items": {
                "not": {
                  "type": "object",
                  "properties": {
                    "name": true
                  },
                  "required": [
                    "name"
                  ]
                },
                "$ref": "#/$defs/result"
              }
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "at",
        "returnsCode",
        "parameters",
        "results"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "query"
            },
            "text": true
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "not": {
                "const": "query"
              }
            }
          },
          "required": [
            "kind"
          ],
          "not": {
            "type": "object",
            "properties": {
              "text": true
            },
            "required": [
              "text"
            ]
          }
        }
      ]
    },
    "parameter": {
      "description": "A declared parameter.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Its name as declared, with its sigil.",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "hasDefault": {
          "description": "Whether the caller may omit it.",
          "type": "boolean"
        },
        "output": {
          "description": "Whether it is an output parameter.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "type",
        "hasDefault",
        "output"
      ],
      "additionalProperties": false
    },
    "result": {
      "description": "One result set.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The set's name, a key of the object its function returns; left out when the object's sets are unnamed, and given for all of them or none.",
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
          "not": {
            "enum": [
              "output",
              "returnValue"
            ]
          }
        },
        "encoding": {
          "enum": [
            "rowset",
            "json"
          ]
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "mayBeAbsent": {
          "description": "Whether the result can arrive with no value at all.",
          "type": "boolean"
        },
        "absentBecause": {
          "$ref": "#/$defs/reasons"
        },
        "cardinality": {
          "enum": [
            "many",
            "atMostOne",
            "one"
          ]
        }
      },
      "required": [
        "encoding",
        "type",
        "mayBeAbsent",
        "cardinality"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mayBeAbsent": {
              "const": true
            },
            "absentBecause": true
          },
          "required": [
            "mayBeAbsent",
            "absentBecause"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mayBeAbsent": {
              "const": false
            }
          },
          "required": [
            "mayBeAbsent"
          ],
          "not": {
            "type": "object",
            "properties": {
              "absentBecause": true
            },
            "required": [
              "absentBecause"
            ]
          }
        }
      ]
    },
    "objectType": {
      "description": "A named object type.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "object"
        },
        "recursive": {
          "description": "Whether the type refers to itself; left out when it doesn't.",
          "type": "boolean"
        },
        "nameDeclared": {
          "description": "Whether the config file gave the type its name; left out when the naming rules did.",
          "type": "boolean"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "required": [
        "kind",
        "fields"
      ],
      "additionalProperties": false
    },
    "identity": {
      "description": "Where a type comes from: the database object it belongs to, keyed by the object's kind, and the path to it there.",
      "type": "object",
      "properties": {
        "procedure": {
          "description": "The procedure the type belongs to.",
          "type": "string"
        },
        "function": {
          "description": "The function the type belongs to.",
          "type": "string"
        },
        "query": {
          "description": "The query the type belongs to.",
          "type": "string"
        },
        "path": {
          "description": "The path to the type, in the IR's path syntax.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "maxProperties": 2,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "procedure": true
          },
          "required": [
            "procedure"
          ]
        },
        {
          "type": "object",
          "properties": {
            "function": true
          },
          "required": [
            "function"
          ]
        },
        {
          "type": "object",
          "properties": {
            "query": true
          },
          "required": [
            "query"
          ]
        }
      ]
    },
    "field": {
      "description": "A field of an object type.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The key or column name.",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "presence": {
          "enum": [
            "always",
            "omittedWhenNull",
            "optional"
          ]
        },
        "nullable": {
          "description": "Whether the value can be null.",
          "type": "boolean"
        },
        "nullableBecause": {
          "$ref": "#/$defs/reasons"
        }
      },
      "required": [
        "name",
        "type",
        "presence",
        "nullable"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "nullable": {
              "const": true
            },
            "nullableBecause": true
          },
          "required": [
            "nullable",
            "nullableBecause"
          ]
        },
        {
          "type": "object",
          "properties": {
            "nullable": {
              "const": false
            }
          },
          "required": [
            "nullable"
          ],
          "not": {
            "type": "object",
            "properties": {
              "nullableBecause": true
            },
            "required": [
              "nullableBecause"
            ]
          }
        }
      ]
    },
    "reasons": {
      "description": "Why a value can be null, or a result absent: at least one reason.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/reason"
      },
      "minItems": 1
    },
    "reason": {
      "description": "One reason a value can be null.",
      "type": "object",
      "properties": {
        "rule": {
          "enum": [
            "nullable-column",
            "unmatched-row",
            "unmatched-lateral-row",
            "empty-subquery",
            "all-fields-null",
            "empty-aggregate",
            "function-result",
            "parameter",
            "null-input",
            "no-rows",
            "not-run",
            "variable",
            "count-overflow",
            "arithmetic-overflow",
            "precision-loss",
            "failed-conversion",
            "subtotal-row",
            "missing-for-action",
            "no-branch-matched",
            "null-literal",
            "out-of-range",
            "read-twice",
            "null-when-equal",
            "json-null-or-absent",
            "empty-frame",
            "window-edge",
            "domain-error",
            "too-few-values",
            "unknown",
            "declared",
            "not-in-both"
          ]
        },
        "at": {
          "description": "What the rule applies to: a column or a source location.",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "at"
      ],
      "additionalProperties": false
    },
    "type": {
      "description": "A type node: a reference to a named type, or a kind.",
      "anyOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "$ref": "#/$defs/array"
        },
        {
          "$ref": "#/$defs/tuple"
        },
        {
          "$ref": "#/$defs/record"
        },
        {
          "$ref": "#/$defs/union"
        },
        {
          "$ref": "#/$defs/jsonText"
        },
        {
          "$ref": "#/$defs/import"
        },
        {
          "$ref": "#/$defs/unknownType"
        }
      ]
    },
    "ref": {
      "description": "A reference to a named object type.",
      "type": "object",
      "properties": {
        "ref": {
          "description": "The type's name in types.",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "scalar": {
      "description": "A scalar with its logical kind, the SQL type it came from, and its facets.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "string",
            "number",
            "boolean",
            "date",
            "time",
            "datetime",
            "uuid"
          ]
        },
        "format": {
          "enum": [
            "uint8",
            "int16",
            "int32",
            "int64",
            "decimal",
            "float",
            "local",
            "offset"
          ]
        },
        "sql": {
          "description": "The source's own type, as written.",
          "type": "string"
        },
        "length": {
          "$ref": "#/$defs/length"
        },
        "maxLength": {
          "$ref": "#/$defs/length"
        },
        "minLength": {
          "$ref": "#/$defs/minLength"
        },
        "digits": {
          "$ref": "#/$defs/digits"
        },
        "min": {
          "$ref": "#/$defs/bound"
        },
        "max": {
          "$ref": "#/$defs/bound"
        },
        "values": {
          "$ref": "#/$defs/values"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "not": {
        "type": "object",
        "properties": {
          "length": true,
          "maxLength": true
        },
        "required": [
          "length",
          "maxLength"
        ]
      }
    },
    "length": {
      "description": "A string's length: a maximum (maxLength) or a fixed length (length).",
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "unit": {
          "enum": [
            "utf16",
            "bytes"
          ]
        },
        "encoding": {
          "enum": [
            "single-byte",
            "utf-8",
            "double-byte"
          ]
        },
        "from": {
          "$ref": "#/$defs/factSource"
        }
      },
      "required": [
        "value",
        "unit",
        "from"
      ],
      "additionalProperties": false
    },
    "minLength": {
      "description": "A string's minimum length in UTF-16 code units.",
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "from": {
          "$ref": "#/$defs/factSource"
        }
      },
      "required": [
        "value",
        "from"
      ],
      "additionalProperties": false
    },
    "digits": {
      "description": "A decimal's precision and scale.",
      "type": "object",
      "properties": {
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "from": {
          "$ref": "#/$defs/factSource"
        }
      },
      "required": [
        "precision",
        "scale",
        "from"
      ],
      "additionalProperties": false
    },
    "bound": {
      "description": "A bound on a number: exact decimal text written as a JSON number, in plain form (no exponent), which a reader must not round. JSON Schema can't check a number's form; the reader refuses any other.",
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "inclusive": {
          "description": "Whether the bound itself is allowed.",
          "type": "boolean"
        },
        "from": {
          "$ref": "#/$defs/factSource"
        }
      },
      "required": [
        "value",
        "inclusive",
        "from"
      ],
      "additionalProperties": false
    },
    "values": {
      "description": "A set the value is drawn from.",
      "type": "object",
      "properties": {
        "match": {
          "enum": [
            "exact",
            "collation",
            "padded",
            "canonical"
          ]
        },
        "items": {
          "description": "The values: strings, or numbers in plain decimal form (no exponent), which JSON Schema can't check and the reader does.",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/factSource"
          }
        },
        "fold": {
          "description": "The name of the fold in folds that gives a value's canonical form: present exactly when the match is canonical.",
          "type": "string"
        }
      },
      "required": [
        "match",
        "items",
        "from"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "match": {
              "const": "canonical"
            },
            "fold": true
          },
          "required": [
            "match",
            "fold"
          ]
        },
        {
          "type": "object",
          "properties": {
            "match": {
              "not": {
                "const": "canonical"
              }
            }
          },
          "required": [
            "match"
          ],
          "not": {
            "type": "object",
            "properties": {
              "fold": true
            },
            "required": [
              "fold"
            ]
          }
        }
      ]
    },
    "fold": {
      "description": "How a collation compares a column's strings. A string's canonical form drops each character of ignored, puts a class's name in place of each character of that class, keeps every other character, and then drops trailing spaces (U+0020), in that order.",
      "type": "object",
      "properties": {
        "ignored": {
          "description": "The characters ignored, in ordinal order.",
          "type": "string"
        },
        "classes": {
          "description": "The characters of each class, in ordinal order, by the class's name, which is what they become.",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "ignored",
        "classes"
      ],
      "additionalProperties": false
    },
    "factSource": {
      "description": "Where a fact came from: one property, named for the kind of source, whose value is the type's or constraint's name or a location.",
      "type": "object",
      "properties": {
        "type": {
          "description": "The type the fact came from.",
          "type": "string"
        },
        "check": {
          "description": "The check the fact came from.",
          "type": "string"
        },
        "engine": {
          "description": "The engine the fact came from.",
          "type": "string"
        },
        "expression": {
          "description": "The expression the fact came from.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "maxProperties": 1,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": true
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "check": true
          },
          "required": [
            "check"
          ]
        },
        {
          "type": "object",
          "properties": {
            "engine": true
          },
          "required": [
            "engine"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expression": true
          },
          "required": [
            "expression"
          ]
        }
      ]
    },
    "array": {
      "description": "An array of items.",
      "type": "object",
      "properties": {
        "kind": {
