<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>haruspex</AssemblyName>
    <RootNamespace>Haruspex.Cli</RootNamespace>
    <Description>The haruspex command line.</Description>
    <!-- The tool runs the same on every machine, whatever its culture: no ICU, so no culture data to differ. Set here, on
         the executable, where it has a runtime meaning; the libraries run under their host's culture, and leaving it off
         them keeps the analysers' culture rules (CA1305, CA1308 and the like) checking them. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The marshalling LibraryImport generates for WindowsConsole's out parameter uses a pointer, which needs unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- A native binary, compiled ahead of time, when the build asks with -p:HaruspexNativeAot=true (CI's AOT job, one per
         platform). Asked for here rather than with -p:PublishAot=true, which would reach every project, the analysers'
         netstandard2.0 one included, which can't be compiled so. Off otherwise, so an ordinary restore needs no AOT
         compiler and the committed lock files hold none. The compiler and the runtime pack it links take the SDK's
         version, and global.json doesn't fix that: its rollForward takes the newest patch of its feature band installed, and
         CI's setup-dotnet installs the newest there is, so a later patch brings a later compiler and runtime. -->
    <PublishAot Condition="'$(HaruspexNativeAot)' == 'true'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <!-- Whether this is a release build, which the binary carries so that it names the schemas of its config file and its JSON
       report at its own tag's address rather than main's (Terminal.IsRelease). Built with -p:HaruspexRelease=true; a release
       names its version, so a release of 0.0.0, the preview's, is refused. -->
  <ItemGroup>
    <AssemblyMetadata Include="HaruspexRelease" Value="$(HaruspexRelease)" Condition="'$(HaruspexRelease)' == 'true'" />
  </ItemGroup>
  <Target Name="HaruspexReleaseVersion" BeforeTargets="CoreCompile" Condition="'$(HaruspexRelease)' == 'true'">
    <Error Condition="'$(VersionPrefix)' == '0.0.0' or '$(VersionSuffix)' != ''"
           Text="A release build names its own version, with no suffix (-p:HaruspexRelease=true -p:VersionPrefix=&lt;its version&gt;), and this one's is $(Version)." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Haruspex.Ir\Haruspex.Ir.csproj" />
    <ProjectReference Include="..\Haruspex.Diagnostics\Haruspex.Diagnostics.csproj" />
    <ProjectReference Include="..\Haruspex.SqlServer.Model\Haruspex.SqlServer.Model.csproj" />
    <ProjectReference Include="..\Haruspex.SqlServer.Sources\Haruspex.SqlServer.Sources.csproj" />
    <ProjectReference Include="..\Haruspex.SqlServer.Inference\Haruspex.SqlServer.Inference.csproj" />
    <ProjectReference Include="..\Haruspex.Config\Haruspex.Config.csproj" />
    <ProjectReference Include="..\Haruspex.Emit.Zod\Haruspex.Emit.Zod.csproj" />
    <ProjectReference Include="..\Haruspex.Emit.JsonSchema\Haruspex.Emit.JsonSchema.csproj" />
    <ProjectReference Include="..\Haruspex.Emit.Mssql\Haruspex.Emit.Mssql.csproj" />
  </ItemGroup>
  <!-- An application's types are internal (CA1515); the tests reach the CLI and SqlProject, the composition of the
       layers, through these. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Haruspex.Tests" />
    <InternalsVisibleTo Include="Haruspex.DifferentialTests" />
  </ItemGroup>
  <!-- The licences that must go with every copy of the native binary, published beside it in a folder of its own:
       haruspex's LICENSE, and under licenses/ a folder per package (named <id>.<version>, as NuGet names its folders) for
       the .NET runtime pack the binary links, the AOT compiler, and the libraries compiled in, whose texts are committed in
       packaging/licenses because their packages carry none (its README says where each came from). The runtime's come
       from the packages this publish restored, so they are the linked runtime's. The pack script refuses a binary that
       arrives without these, so CI can't make an npm package without them. -->
  <Target Name="HaruspexLicenses" AfterTargets="Publish" Condition="'$(PublishAot)' == 'true'">
    <Error Condition="'@(ResolvedTargetILCompilerPack)' == '' or '@(ResolvedILCompilerPack)' == ''"
           Text="The Native AOT runtime pack or compiler package wasn't resolved, so their licences can't be published with the binary." />
    <ItemGroup>
      <HaruspexLicense Include="$(MSBuildThisFileDirectory)../../LICENSE" Folder="" />
      <HaruspexCommittedLicense Include="$(MSBuildThisFileDirectory)../../packaging/licenses/**/*"
                                Exclude="$(MSBuildThisFileDirectory)../../packaging/licenses/README.md" />
      <HaruspexLicense Include="@(ResolvedTargetILCompilerPack->'%(PackageDirectory)/LICENSE.TXT');@(ResolvedTargetILCompilerPack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')"
                       Folder="licenses/@(ResolvedTargetILCompilerPack->'%(Identity).%(NuGetPackageVersion)')/" />
      <HaruspexLicense Include="@(ResolvedILCompilerPack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')"
                       Folder="licenses/@(ResolvedILCompilerPack->'%(Identity).%(NuGetPackageVersion)')/" />
    </ItemGroup>
    <!-- Copy fails the publish if a file is missing, so a binary is never published without one of them. -->
    <Copy SourceFiles="@(HaruspexLicense)" DestinationFiles="@(HaruspexLicense->'$(PublishDir)%(Folder)%(Filename)%(Extension)')" />
    <!-- Each committed folder as it is: its name is the package's. -->
    <Copy SourceFiles="@(HaruspexCommittedLicense)"
          DestinationFiles="@(HaruspexCommittedLicense->'$(PublishDir)licenses/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <!-- The commit in a preview's version, so the binary says the same version as the npm package it ships in. The commit is the
       one the SDK reads from git (SourceRevisionId); it appends the whole of it after a +, which the pack script checks. A
       target, not a property, because the commit is known only once the build has asked git for it. It is here, in the
       command's project, not in Directory.Build.props: a database project below this repository (the test fixtures) imports
       that file too, and haruspex reports a target it can't read there. -->
  <Target Name="HaruspexPreviewVersion"
          AfterTargets="InitializeSourceControlInformation"
          BeforeTargets="AddSourceRevisionToInformationalVersion"
          Condition="'$(VersionSuffix)' == 'preview' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(SourceRevisionId)', '^[0-9a-f]{40}$'))">
    <PropertyGroup>
      <InformationalVersion>$(VersionPrefix)-preview-$(SourceRevisionId.Substring(0, 8))</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
