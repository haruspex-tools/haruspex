<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>haruspex</AssemblyName>
    <RootNamespace>Haruspex.Cli</RootNamespace>
    <Description>The haruspex command line.</Description>
    <!-- The tool runs the same on every machine, whatever its culture: no ICU, so no culture data to differ. Set here, on
         the executable, where it has a runtime meaning; the libraries run under their host's culture, and leaving it off
         them keeps the analysers' culture rules (CA1305, CA1308 and the like) checking them. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- A native binary, compiled ahead of time, when the build asks with -p:HaruspexNativeAot=true (CI's AOT job, one per
         platform). Asked for here rather than with -p:PublishAot=true, which would reach every project, the analysers'
         netstandard2.0 one included, which can't be compiled so. Off otherwise, so an ordinary restore needs no AOT
         compiler and the committed lock files hold none: the compiler's version is the SDK's, which global.json pins. -->
    <PublishAot Condition="'$(HaruspexNativeAot)' == 'true'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Haruspex.Ir\Haruspex.Ir.csproj" />
    <ProjectReference Include="..\Haruspex.Diagnostics\Haruspex.Diagnostics.csproj" />
    <ProjectReference Include="..\Haruspex.SqlServer.Model\Haruspex.SqlServer.Model.csproj" />
    <ProjectReference Include="..\Haruspex.SqlServer.Sources\Haruspex.SqlServer.Sources.csproj" />
    <ProjectReference Include="..\Haruspex.SqlServer.Inference\Haruspex.SqlServer.Inference.csproj" />
    <ProjectReference Include="..\Haruspex.Config\Haruspex.Config.csproj" />
    <ProjectReference Include="..\Haruspex.Emit.Zod\Haruspex.Emit.Zod.csproj" />
    <ProjectReference Include="..\Haruspex.Emit.JsonSchema\Haruspex.Emit.JsonSchema.csproj" />
    <ProjectReference Include="..\Haruspex.Emit.Mssql\Haruspex.Emit.Mssql.csproj" />
  </ItemGroup>
  <!-- An application's types are internal (CA1515); the tests reach the CLI and SqlProject, the composition of the
       layers, through these. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Haruspex.Tests" />
    <InternalsVisibleTo Include="Haruspex.DifferentialTests" />
  </ItemGroup>
</Project>
