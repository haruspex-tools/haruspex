<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Infers the haruspex IR from bound SQL Server procedure bodies: result shapes, nullability, presence and JSON structure.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Haruspex.Diagnostics\Haruspex.Diagnostics.csproj" />
    <ProjectReference Include="..\Haruspex.SqlServer.Model\Haruspex.SqlServer.Model.csproj" />
    <ProjectReference Include="..\Haruspex.SqlServer.Semantics\Haruspex.SqlServer.Semantics.csproj" />
    <ProjectReference Include="..\Haruspex.Ir\Haruspex.Ir.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- For ValueEqualityTests: the laws of equality are about the shapes and values the fixed points compare, which are internal. -->
    <InternalsVisibleTo Include="Haruspex.Tests" />
    <!-- For ConversionObservationTests: each row of the table of conversions (Typing/Conversions.cs) is checked against the server. -->
    <InternalsVisibleTo Include="Haruspex.DifferentialTests" />
  </ItemGroup>
</Project>
