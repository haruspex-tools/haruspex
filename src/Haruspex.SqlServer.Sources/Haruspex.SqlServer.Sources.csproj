<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Reads a SQL Server database project's folder of .sql scripts, or a DACPAC and the DACPACs it references, into Haruspex.SqlServer.Model, with ScriptDom and without DacFx. Read-only: it never builds or deploys a DACPAC.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>Haruspex.SqlServer.Sources</PackageId>
    <PackageTags>sql-server;t-sql;schema;scriptdom;database-project;sqlproj;dacpac</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Haruspex.Diagnostics\Haruspex.Diagnostics.csproj" />
    <ProjectReference Include="..\Haruspex.SqlServer.Model\Haruspex.SqlServer.Model.csproj" />
    <ProjectReference Include="..\Haruspex.SqlServer.Syntax\Haruspex.SqlServer.Syntax.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <!-- The order a referenced DACPAC is looked for in is tested on the finder itself (DacpacReaderTests). -->
    <InternalsVisibleTo Include="Haruspex.Tests" />
  </ItemGroup>
</Project>
