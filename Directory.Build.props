<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Every SDK analyser on, and every code-style rule enforced by the build. The few rules turned off, and the
         style preferences, are in .editorconfig, each with its reason. -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- In every project, tests included: the compiler reports unused usings (IDE0005) only where it builds the
         documentation file. Whether a missing comment is an error (CS1591) is set per layer in .editorconfig. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>

    <!-- Nothing is published yet. The reusable layers that may be (Haruspex.SqlServer.Model, .Syntax and .Sources,
         and Haruspex.Diagnostics, which their API uses) opt in with their package metadata; everything else stays
         unpackable. -->
    <IsPackable>false</IsPackable>

    <!-- Pre-release: nothing is stable yet. The IR has its own version (IrDocument.CurrentVersion). A preview's version is
         0.0.0-preview-<the commit's first eight hex digits>, as its npm packages' is (packaging/npm/version.mjs): the target
         HaruspexPreviewVersion, below, adds the commit, and the SDK then appends the whole commit after a +, so the binary's
         version names the package it ships in. Built outside a git checkout, it is 0.0.0-preview. -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>preview</VersionSuffix>
    <Authors>Richard Baker</Authors>
    <Copyright>Copyright 2026 Richard Baker</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/sharpblue/haruspex</RepositoryUrl>

    <!-- Lock files are committed, so a restore cannot silently pick up a different package. CI restores
         in locked mode, which fails if a lock file is out of date. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Haruspex's own build-time checks (analysers/README.md), run on every project but themselves; a build-time reference,
       so no package depends on them. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Haruspex.Analysers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analysers/Haruspex.Analysers/Haruspex.Analysers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- The commit in a preview's version, so the binary says the same version as the npm package it ships in. The commit is the
       one the SDK reads from git (SourceRevisionId); it appends the whole of it after a +, which the pack script checks. A
       target, not a property, because the commit is known only once the build has asked git for it. -->
  <Target Name="HaruspexPreviewVersion"
          AfterTargets="InitializeSourceControlInformation"
          BeforeTargets="AddSourceRevisionToInformationalVersion"
          Condition="'$(VersionSuffix)' == 'preview' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(SourceRevisionId)', '^[0-9a-f]{40}$'))">
    <PropertyGroup>
      <InformationalVersion>$(VersionPrefix)-preview-$(SourceRevisionId.Substring(0, 8))</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
