<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Every SDK analyser on, and every code-style rule enforced by the build. The few rules turned off, and the
         style preferences, are in .editorconfig, each with its reason. -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- In every project, tests included: the compiler reports unused usings (IDE0005) only where it builds the
         documentation file. Whether a missing comment is an error (CS1591) is set per layer in .editorconfig. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>

    <!-- Nothing is published yet. The reusable layers that may be (Haruspex.SqlServer.Model, .Syntax and .Sources,
         and Haruspex.Diagnostics and Haruspex.Collections, which their API uses) opt in with their package metadata;
         everything else stays unpackable. -->
    <IsPackable>false</IsPackable>

    <!-- Pre-release: nothing is stable yet. The IR has its own version (IrDocument.CurrentVersion). A preview's version is
         0.0.0-preview-<the commit's first eight hex digits>, as its npm packages' is (packaging/npm/version.mjs): the command's
         project adds the commit (its target HaruspexPreviewVersion), and the SDK then appends the whole commit after a +, so the
         binary's version names the package it ships in. Built outside a git checkout, it is 0.0.0-preview.
         A release is built with -p:HaruspexRelease=true -p:VersionPrefix=<its version>, from the commit tagged v<its version>
         (packaging/npm/README.md, "A release"): it has no suffix, and the command names the schemas at that tag's address. -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(HaruspexRelease)' != 'true'">preview</VersionSuffix>
    <Authors>Richard Baker</Authors>
    <Copyright>Copyright 2026 Richard Baker</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/haruspex-tools/haruspex</RepositoryUrl>

    <!-- Lock files are committed, so a restore cannot silently pick up a different package. CI restores
         in locked mode, which fails if a lock file is out of date or a package's content hash differs from the one locked.
         One restore can't be locked: the Native AOT publish (CI's native job), whose runtime identifier changes every
         lock file and adds the AOT compiler and runtime packs, which follow the SDK's patch and so aren't locked. That job
         runs the locked restore first, so only those packs come unchecked (src/Haruspex.Cli/Haruspex.Cli.csproj). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Haruspex's own build-time checks (analysers/README.md), run on every project but themselves; a build-time reference,
       so no package depends on them. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Haruspex.Analysers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analysers/Haruspex.Analysers/Haruspex.Analysers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
</Project>
