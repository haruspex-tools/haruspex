<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Nothing is published yet. The reusable layers that may be (Haruspex.SqlServer.Model and .Sources, and
         Haruspex.Diagnostics, which their API uses) opt in with their package metadata; everything else stays
         unpackable. -->
    <IsPackable>false</IsPackable>

    <!-- Pre-release: nothing is stable yet. The IR has its own version (IrDocument.CurrentVersion). -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <Authors>Richard Baker</Authors>
    <Copyright>Copyright 2026 Richard Baker</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/sharpblue/haruspex</RepositoryUrl>

    <!-- Lock files are committed, so a restore cannot silently pick up a different package. CI restores
         in locked mode, which fails if a lock file is out of date. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
