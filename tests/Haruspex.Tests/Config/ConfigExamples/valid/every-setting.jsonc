// Every setting, with comments and trailing commas.
{
  "$schema": "../../../../schemas/haruspex.schema.json",
  "source": "database",
  "baseline": "build/release/Shop.dacpac",
  "collation": "Latin1_General_100_CI_AS",
  "queries": ["sql", "reports/**/*.sql"],
  "out": "generated",
  "objects": "strip",
  "emit": ["zod", "json-schema"],
  "check": { "unknowns": "fail" },
  "session": { "ansiWarnings": true, "arithAbort": true, "concatNullYieldsNull": true, "numericRoundAbort": false },
  "naming": {
    "replace": [{ "pattern": "#$", "with": "Row" }],
    "case": "camel",
  },
  "schemas": {
    "sales": { "include": ["get_*", "list_*"], "exclude": ["*_internal"] },
    "audit": { "include": ["*"], "prefix": "Audit" },
    "RDF.": { "include": ["GetPropertyList"], "naming": { "case": "preserve", "replace": [{ "pattern": "^Get", "with": "" }] } },
    "reference": {},
  },
  "procedures": {
    "sales.get_order": {
      "name": "OrderDetail",
      "paths": {
        "lines[]": { "name": "OrderLine" },
        "note": { "nullable": false, "why": "always written by the application" },
        "status": { "values": "exact", "why": "lower case only" },
        "settings": { "type": "SettingsSchema", "import": "./settings", "why": "the application's own format" },
        "tags": { "type": "TagSchema[]", "import": "@app/tags" },
        "results[0][\"unit price\"]": { "nullable": false, "why": "priced on insert" },
      },
    },
    "[RDF.].GetPropertyList": { "name": "PropertyList" },
    "sales.get_order_with_lines": { "sets": ["order", "lines"] },
    "audit.write_log": { "results": "none", "why": "it only writes to the log" },
    "sales.search_orders": {
      "name": "OrderSearch",
      "results": [
        { "rowset": { "type": "object", "properties": { "order_id": { "type": "integer", "format": "int32" }, "note": { "type": ["string", "null"] } } } },
        { "json": { "type": "array", "items": { "$ref": "#/$defs/total" }, "$defs": { "total": { "type": "object", "properties": { "n": { "type": "integer" } }, "required": ["n"] } } }, "mayBeAbsent": true },
      ],
      "sets": ["orders", "totals"],
      "why": "the filter is built as dynamic SQL",
    },
  },
}
