// Every setting, with comments and trailing commas.
{
  "$schema": "../../../../schemas/haruspex.schema.json",
  "source": "database",
  "baseline": "build/release/Shop.dacpac",
  "references": ["."],
  "builds": ["Shop.dacpac", "Ledger.DACPAC"],
  "collation": "Latin1_General_100_CI_AS",
  "queries": ["sql", "reports/**/*.sql"],
  "out": "generated",
  "split": { "sales": ["sales", "shop"], "admin": ["admin"] },
  "objects": "strip",
  "emit": ["zod", "json-schema", "mssql", "mapping"],
  "serverOnly": true,
  "comments": "all",
  "check": { "unknowns": "fail" },
  "session": { "ansiWarnings": true, "arithAbort": true, "concatNullYieldsNull": true, "numericRoundAbort": false, "unmask": false },
  "acknowledge": [
    { "code": "HAR1008", "subject": "StampBuildInfo", "why": "it stamps the build's number and adds no scripts" },
    { "code": "HAR1008", "subject": "SignAssemblies", "why": "it signs the CLR assemblies and adds no scripts" },
  ],
  "columns": {
    "parcels.parcel.route": { "json": "../../../../fixtures/parcels/schemas/stops.schema.json#/$defs/route" },
  },
  "parameters": {
    "parcels.quote_options.@stops": { "json": "../../../../fixtures/parcels/schemas/stops.schema.json#/$defs/route" },
  },
  "endpoints": [
    { "url": "https://billing.example/plans/{id}", "method": "GET", "response": "../../../../fixtures/parcels/schemas/stops.schema.json#/$defs/route" },
  ],
  "naming": {
    "replace": [{ "pattern": "#$", "with": "Row" }],
    "case": "camel",
  },
  "schemas": {
    "sales": { "include": ["get_*", "list_*"], "exclude": ["*_internal"] },
    "audit": { "include": ["*"], "prefix": "Audit" },
    "Ledger.": { "include": ["GetEntryList"], "naming": { "case": "preserve", "replace": [{ "pattern": "^Get", "with": "" }] } },
    "reference": {},
  },
  "procedures": {
    "sales.get_order": {
      "name": "OrderDetail",
      "paths": {
        "lines[]": { "name": "OrderLine" },
        "note": { "nullable": false, "why": "always written by the application" },
        "status": { "values": "exact", "why": "lower case only" },
        "settings": { "type": "SettingsSchema", "import": "./settings", "why": "the application's own format" },
        "tags": { "type": "TagSchema[]", "import": "@app/tags" },
        "results[0][\"unit price\"]": { "nullable": false, "why": "priced on insert" },
      },
    },
    "[Ledger.].GetEntryList": { "name": "EntryList" },
    "sales.get_order_with_lines": { "sets": ["order", "lines"] },
    "audit.write_log": { "results": "none", "why": "it only writes to the log" },
    "sales.search_orders": {
      "name": "OrderSearch",
      "results": [
        { "rowset": { "type": "object", "properties": { "order_id": { "type": "integer", "format": "int32" }, "note": { "type": ["string", "null"] } } } },
        { "json": { "type": "array", "items": { "$ref": "#/$defs/total" }, "$defs": { "total": { "type": "object", "properties": { "n": { "type": "integer" } }, "required": ["n"] } } }, "mayBeAbsent": true },
      ],
      "sets": ["orders", "totals"],
      "why": "the filter is built as dynamic SQL",
    },
  },
}
