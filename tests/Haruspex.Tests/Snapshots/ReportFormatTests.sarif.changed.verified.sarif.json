{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "haruspex",
          "version": "0.0.0-test",
          "informationUri": "https://github.com/sharpblue/haruspex",
          "rules": [
            {
              "id": "HAR2009",
              "shortDescription": {
                "text": "A column that can't be found or is ambiguous"
              },
              "helpUri": "https://github.com/sharpblue/haruspex/blob/main/docs/diagnostics/HAR2009.md",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "HAR2013",
              "shortDescription": {
                "text": "JSON whose shape isn't visible"
              },
              "helpUri": "https://github.com/sharpblue/haruspex/blob/main/docs/diagnostics/HAR2013.md",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "HAR4204",
              "shortDescription": {
                "text": "Result sets only a declaration can give"
              },
              "helpUri": "https://github.com/sharpblue/haruspex/blob/main/docs/diagnostics/HAR4204.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "exitCode": 0
        }
      ],
      "results": [
        {
          "ruleId": "HAR4204",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "kennel.find_dogs: its result sets are unknown: EXEC sp_executesql @sql runs dynamic SQL, a string built when the procedure runs, so its result sets are not known. (procedures.sql:9:1) Declare them in haruspex.json under procedures[\"kennel.find_dogs\"].results, as \"none\" or a JSON Schema, or declare the results of the procedure that runs it."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "haruspex.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "HAR2009",
          "ruleIndex": 0,
          "level": "note",
          "message": {
            "text": "kennel.get_dog results[0][].nickname: The table kennel.dog has no column nickname."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "db/procedures.sql"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 26
                }
              }
            }
          ]
        },
        {
          "ruleId": "HAR2013",
          "ruleIndex": 1,
          "level": "note",
          "message": {
            "text": "kennel.list_dogs results[0][].notes: json_query(d.notes) reads JSON that is not built here, so its shape is unknown."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "db/procedures.sql"
                },
                "region": {
                  "startLine": 2,
                  "startColumn": 26
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
