{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "haruspex",
          "version": "0.0.0-test",
          "informationUri": "https://github.com/sharpblue/haruspex",
          "rules": [
            {
              "id": "HAR2009",
              "shortDescription": {
                "text": "A column that can't be found or is ambiguous"
              },
              "helpUri": "https://github.com/sharpblue/haruspex/blob/main/docs/diagnostics/HAR2009.md",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "HAR2013",
              "shortDescription": {
                "text": "JSON whose shape isn't visible"
              },
              "helpUri": "https://github.com/sharpblue/haruspex/blob/main/docs/diagnostics/HAR2013.md",
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "HAR4204",
              "shortDescription": {
                "text": "Result sets only a declaration can give"
              },
              "helpUri": "https://github.com/sharpblue/haruspex/blob/main/docs/diagnostics/HAR4204.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "HAR6014",
              "shortDescription": {
                "text": "What the module claims would change"
              },
              "helpUri": "https://github.com/sharpblue/haruspex/blob/main/docs/diagnostics/HAR6014.md",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "HAR6016",
              "shortDescription": {
                "text": "A selected procedure's result sets are unknown"
              },
              "helpUri": "https://github.com/sharpblue/haruspex/blob/main/docs/diagnostics/HAR6016.md",
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
