          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "kennel.find_dogs: its result sets are unknown: EXEC sp_executesql @sql runs dynamic SQL, a string built when the procedure runs, so its result sets are not known. (procedures.sql:9:1) Declare them in haruspex.json under procedures[\"kennel.find_dogs\"].results, as \"none\" or a JSON Schema, or declare the results of the procedure that runs it."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "haruspex.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "HAR2009",
          "ruleIndex": 0,
