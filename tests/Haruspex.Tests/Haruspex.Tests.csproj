<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xunit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- These tests run the CLI in process, so they run it as it ships (see Haruspex.Cli.csproj). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Support both test projects use: finding the fixtures and running the emit-check npm package. -->
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- To compile code with haruspex's own analysers in ExhaustiveSwitchTests. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Microsoft's master.dacpac, restored and read where NuGet put it: no assets of it are built into anything or copied. -->
    <PackageReference Include="Microsoft.SqlServer.Dacpacs.Master" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- Where the restore put that package, for the test that reads it (OtherDatabasesTests). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MasterDacpacPackage</_Parameter1>
      <_Parameter2>$(PkgMicrosoft_SqlServer_Dacpacs_Master)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Haruspex.Collections\Haruspex.Collections.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.Ir\Haruspex.Ir.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.Diagnostics\Haruspex.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.SqlServer.Model\Haruspex.SqlServer.Model.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.SqlServer.Syntax\Haruspex.SqlServer.Syntax.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.SqlServer.Sources\Haruspex.SqlServer.Sources.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.SqlServer.Semantics\Haruspex.SqlServer.Semantics.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.SqlServer.Inference\Haruspex.SqlServer.Inference.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.Config\Haruspex.Config.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.Emit.Zod\Haruspex.Emit.Zod.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.Emit.JsonSchema\Haruspex.Emit.JsonSchema.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.Cli\Haruspex.Cli.csproj" />
  </ItemGroup>
</Project>
