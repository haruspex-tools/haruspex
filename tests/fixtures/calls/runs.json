// The runs of the calls fixture against SQL Server, found by the differential tests. tests/fixtures/README.md says
// what each key means.
{
  "setups": {
    "nothing baked": "DELETE FROM calls.delivery; DELETE FROM calls.batch; DELETE FROM calls.oven;"
  },

  "runs": [
    { "name": "oven_list", "procedure": "calls.oven_list" },
    { "name": "daily_report", "procedure": "calls.daily_report" },
    { "name": "daily_report, one day", "procedure": "calls.daily_report", "parameters": { "@day": "2026-11-03" } },
    { "name": "daily_report, with placeholders", "procedure": "calls.daily_report", "parameters": { "@placeholder": true } },
    { "name": "batch_rows", "procedure": "calls.batch_rows" },
    { "name": "batch_rows, an oven without racks", "procedure": "calls.batch_rows", "parameters": { "@oven": 2 } },
    { "name": "batch_rows, an oven with racks", "procedure": "calls.batch_rows", "parameters": { "@oven": 1 } },
    { "name": "rack_sizes", "procedure": "calls.rack_sizes" },
    { "name": "batch_feed", "procedure": "calls.batch_feed" },
    { "name": "batch_feed, one oven", "procedure": "calls.batch_feed", "parameters": { "@oven": 2 } },
    { "name": "batch_feed, nothing baked", "procedure": "calls.batch_feed", "setup": "nothing baked" },
    { "name": "walk_even, no steps", "procedure": "calls.walk_even", "parameters": { "@n": 0 } },
    { "name": "walk_even, one step", "procedure": "calls.walk_even", "parameters": { "@n": 1 } },
    { "name": "walk_odd, no steps", "procedure": "calls.walk_odd", "parameters": { "@n": 0 } },
    { "name": "walk_odd, three steps", "procedure": "calls.walk_odd", "parameters": { "@n": 3 } },
    { "name": "ovens_or_batches, ovens", "procedure": "calls.ovens_or_batches", "parameters": { "@ovens": true } },
    { "name": "ovens_or_batches, batches", "procedure": "calls.ovens_or_batches", "parameters": { "@ovens": false } },
    { "name": "ovens_or_batches, an oven without racks", "procedure": "calls.ovens_or_batches", "parameters": { "@ovens": false, "@oven": 2 } },
    { "name": "ovens_or_batches, an oven with racks", "procedure": "calls.ovens_or_batches", "parameters": { "@ovens": false, "@oven": 1 } },
    { "name": "search_batches", "procedure": "calls.search_batches", "parameters": { "@product": "%r%" } },
    { "name": "search_batches, no match", "procedure": "calls.search_batches", "parameters": { "@product": "zzz" } },
    { "name": "rack_counts", "procedure": "calls.rack_counts" },
    { "name": "delivery_stage", "procedure": "calls.delivery_stage" },
    { "name": "recount_from, no steps", "procedure": "calls.recount_from", "parameters": { "@n": 0 } },
    { "name": "recount_from, one step", "procedure": "calls.recount_from", "parameters": { "@n": 1 } },
    { "name": "maybe_ovens, shown", "procedure": "calls.maybe_ovens", "parameters": { "@show": true } },
    { "name": "maybe_ovens, not shown", "procedure": "calls.maybe_ovens", "parameters": { "@show": false } },
    { "name": "maybe_then_batches, ovens first", "procedure": "calls.maybe_then_batches", "parameters": { "@show": true } },
    { "name": "maybe_then_batches, no ovens", "procedure": "calls.maybe_then_batches", "parameters": { "@show": false } },
    { "name": "search_with_ovens", "procedure": "calls.search_with_ovens", "parameters": { "@product": "%e%" } },
    { "name": "oven_cards", "procedure": "calls.oven_cards" },
    { "name": "oven_cards, no ovens", "procedure": "calls.oven_cards", "setup": "nothing baked" },
    { "name": "search_declared", "procedure": "calls.search_declared", "parameters": { "@product": "%r%" } },
    { "name": "search_declared, no match", "procedure": "calls.search_declared", "parameters": { "@product": "zzz" } },
    { "name": "quiet_then_ovens", "procedure": "calls.quiet_then_ovens" },
    { "name": "getBakeSheet, an oven with racks", "query": "sql/getBakeSheet.sql", "parameters": { "@ovenId": 1 } },
    { "name": "getBakeSheet, an oven without racks", "query": "sql/getBakeSheet.sql", "parameters": { "@ovenId": 2 } },
    { "name": "getBakeSheet, no such oven", "query": "sql/getBakeSheet.sql", "parameters": { "@ovenId": 9 } }
  ],

  "notRun": {
    "calls.picked_batches": "It reads its caller's #picked, so it runs only when called: through calls.daily_report, which is run.",
    "calls.recount": "It reads and writes its caller's #counts, so it runs only when called: through calls.recount_from, which is run.",
    "calls.add_placeholder": "It writes its caller's #picked, so it runs only when called: through calls.daily_report, which is run."
  }
}
