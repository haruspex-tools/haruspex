// The runs of the till fixture against SQL Server, found by the differential tests. tests/fixtures/README.md says what each
// key means.
{
  // Not held to every edge: its point is the parameters, whose edges ParameterObservationTests sends to the server one by
  // one.
  "seedReachesEveryEdge": false,

  // Edges of facts the types alone don't give that no run can reach, each with the reason.
  "edgesNotReached": {
    "till.basket_total results[0][].quantity: min": "The body inserts a quantity of 2, so the line type's CHECK (quantity > 0) is never met at 1; the IR claims the CHECK's bound, which is only wider."
  },

  "runs": [
    { "name": "find_products, by name", "procedure": "till.find_products", "parameters": { "@name": "Tea" } },
    { "name": "find_products, by name, code and label", "procedure": "till.find_products", "parameters": { "@name": "Tea", "@sku": "TEA-0001", "@label": "tea" } },
    { "name": "price_band, from a price", "procedure": "till.price_band", "parameters": { "@lowest": 2.25 } },
    { "name": "price_band, a band with a rate and a fee", "procedure": "till.price_band", "parameters": { "@lowest": 1, "@highest": 5, "@rate": 1.2345, "@fee": 0.5 } },
    { "name": "shift_times, the day and the opening", "procedure": "till.shift_times", "parameters": { "@day": "2026-11-16", "@opened_at": "2026-11-16T08:30:00" } },
    {
      "name": "shift_times, every type",
      "procedure": "till.shift_times",
      "parameters": {
        "@day": "2026-11-16", "@opened_at": "2026-11-16T08:30:00", "@logged_at": "2026-11-16T08:30:00.997",
        "@rota_slot": "2026-11-16T09:00:00", "@till_time": "08:30:00.125", "@stamped_at": "2026-11-16T08:30:00.1234567+05:30"
      }
    },
    // The earliest day and the seventh fractional digit, which reach the procedure only when each is sent as its declared type
    // (FixtureOutputTests.A_run_s_date_argument_reaches_the_procedure_as_written).
    {
      "name": "shift_times, the edges",
      "procedure": "till.shift_times",
      "parameters": { "@day": "0001-01-01", "@opened_at": "0001-01-01T00:00:00", "@clocked_at": "2026-11-16T08:30:00.1234567" }
    },
    { "name": "price_band, a null rate", "procedure": "till.price_band", "parameters": { "@lowest": 1, "@rate": null } },
    { "name": "shift_times, nulls", "procedure": "till.shift_times", "parameters": { "@day": null, "@opened_at": null } },
    { "name": "ring_up, nulls", "procedure": "till.ring_up", "parameters": { "@product_id": 1, "@quantity": 1, "@basket_id": null, "@discount": null, "@gift": null } },
    { "name": "basket_total, a product", "procedure": "till.basket_total", "parameters": { "@product_id": 1 } },
    { "name": "basket_total, a product and a note", "procedure": "till.basket_total", "parameters": { "@product_id": 2, "@note": "gift" } },
    { "name": "basket_total, none", "procedure": "till.basket_total", "parameters": { "@product_id": 99 } },
    { "name": "ring_up, the least", "procedure": "till.ring_up", "parameters": { "@product_id": 1, "@quantity": 2, "@basket_id": 9007199254740993 } },
    {
      "name": "ring_up, everything",
      "procedure": "till.ring_up",
      "parameters": {
        "@product_id": 3, "@quantity": -1, "@basket_id": -9223372036854775808, "@discount": 255, "@gift": true,
        "@token": "0f8fad5b-d9cb-469f-a165-70867728950e", "@weight": 0.5, "@ratio": 1e300
      }
    }
  ],

  "notRun": {
    "till.add_lines": "Its table-valued parameter is one runs.json can't give; MssqlFunctionTests.The_till_fixture_s_table_valued_parameters_return_what_their_schemas_accept calls it with rows, and ParameterObservationTests with the table left out.",
    "till.grade_of": "Its table-valued parameter is one runs.json can't give; MssqlFunctionTests.The_till_fixture_s_table_valued_parameters_return_what_their_schemas_accept calls it with rows.",
    "till.echo_readings": "Its table-valued parameter is one runs.json can't give; MssqlFunctionTests.The_till_fixture_s_table_valued_parameters_return_what_their_schemas_accept calls it with rows.",
    "till.count_serials": "Its table-valued parameter is one runs.json can't give; MssqlFunctionTests.The_till_fixture_s_table_valued_parameters_return_what_their_schemas_accept calls it with the table left out, since no row can be sent in its type.",
    "till.echo_echoes": "Its table-valued parameters are ones runs.json can't give; MssqlFunctionTests.The_till_fixture_s_table_valued_parameters_return_what_their_schemas_accept calls it with rows."
  }
}
