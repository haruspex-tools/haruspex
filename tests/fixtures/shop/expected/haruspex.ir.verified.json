    {
      "id": "queries/products_under.sql",
      "name": "ProductsUnder",
      "kind": "query",
      "at": "queries/products_under.sql:1:1",
      "text": "-- Products at or under a price, cheapest first, a page at a time; every status when @status is NULL. Its one set is named,\n-- so its function returns { products }.\n-- @sets products\nSELECT p.product_id, p.sku, p.name, p.price\nFROM shop.product AS p\nWHERE p.price <= @max_price AND (p.status = @status OR @status IS NULL)\nORDER BY p.price, p.product_id\nOFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;\n",
      "returnsCode": false,
      "parameters": [
        {
