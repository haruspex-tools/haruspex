    {
      "id": "queries/basket_card.sql",
      "name": "BasketCard",
      "kind": "query",
      "at": "queries/basket_card.sql:1:1",
      "text": "-- A basket and its lines as one JSON document, headed by a label the caller chooses, which nothing in the query types.\n-- @param @label nvarchar(40)\nSELECT\n    @label AS label,\n    b.basket_id,\n    (SELECT l.line_no, l.quantity FROM shop.basket_line AS l WHERE l.basket_id = b.basket_id ORDER BY l.line_no FOR JSON PATH) AS lines\nFROM shop.basket AS b\nWHERE b.basket_id = @basket_id\nFOR JSON PATH, WITHOUT_ARRAY_WRAPPER;\n",
      "returnsCode": false,
      "parameters": [
        {
          "name": "@label",
          "type": {
            "kind": "string",
            "sql": "nvarchar(40)",
            "maxLength": {
              "value": 40,
