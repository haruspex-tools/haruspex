// The config file of an invented shop, used end to end by ConfigCliTests: selection, overrides, strict objects, both
// emitters and naming. Comments and trailing commas are allowed, as in tsconfig.json.
{
  "$schema": "../../../schemas/haruspex.schema.json",
  "source": "database",
  "out": "generated",

  // Queries the application keeps in its own files, typed with the procedures and given functions beside theirs.
  "queries": "queries",

  // The application deploys together with the database, so an unexpected key should fail loudly.
  "objects": "strict",

  // A service in another language validates the same results, so a JSON Schema is written beside the Zod; and the
  // application calls the procedures through the generated functions, on the server only (a Next.js application).
  "emit": ["zod", "json-schema", "mssql"],
  "serverOnly": true,

  // Naming for every schema: a trailing # marks a procedure returning one row.
  "naming": {
    "replace": [{ "pattern": "#$", "with": "Row" }],
    "case": "pascal",
  },

  // Selection, prefixes and naming per schema. A key is the schema's name as it is.
  "schemas": {
    "shop": { "include": ["*"], "exclude": ["*_internal"] },
    // Admin's reports are prefixed, so they can never clash with the shop's names, and lose their report_ (this rule
    // runs after the top-level ones): shop_admin.report_sales is AdminSales.
    "shop_admin": {
      "include": ["report_*"],
      "prefix": "Admin",
      "naming": { "replace": [{ "pattern": "^report_", "with": "" }] },
    },
  },

  "procedures": {
    "shop.get_basket": {
      "name": "Basket",
      "paths": {
        "customerName": { "nullable": false, "why": "every basket belongs to a customer: there is no guest checkout" },
        "lines[]": { "name": "BasketItem" },
      },
    },
    // Its rows and report_stock's are one shape, which this name declares, so the module declares it once under it.
    "shop_admin.report_sales": { "paths": { "[]": { "name": "PriceListItem" } } },
    // Named sets: its function returns { products, count }, and its types are named after them (AdminStockCountRow).
    "shop_admin.report_stock": { "sets": ["products", "count"] },
    "shop.list_products": {
      "paths": {
        "[].status": { "values": "exact", "why": "the application writes the status in lower case only" },
        "[].attributes": { "type": "ProductAttributesSchema", "import": "@shop/types" },
      },
    },
  },
}
