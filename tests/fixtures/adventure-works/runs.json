{
  // The facets of money and decimal(8, 2) reach far past any cost or quantity, so the seed is not held to every edge.
  "seedReachesEveryEdge": false,

  "setups": {
    // A spoke given away, at the least cost CK_Product_StandardCost allows (StandardCost >= 0.00).
    "a component that costs nothing": "UPDATE Production.Product SET StandardCost = 0.00 WHERE ProductID = 5;"
  },

  "runs": [
    { "name": "GetProductTree, three levels", "procedure": "Production.GetProductTree", "parameters": { "@ProductID": 1 } },
    { "name": "GetProductTree, a component that costs nothing", "procedure": "Production.GetProductTree", "parameters": { "@ProductID": 1 }, "setup": "a component that costs nothing" },
    { "name": "GetProductTree, no components", "procedure": "Production.GetProductTree", "parameters": { "@ProductID": 5 } },
    { "name": "GetProductTree, no such product", "procedure": "Production.GetProductTree", "parameters": { "@ProductID": 999 } }
  ]
}
