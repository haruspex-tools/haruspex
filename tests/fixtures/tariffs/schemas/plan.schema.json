{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A plan, as the invented billing service sends it.",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "integer", "format": "int32" },
    "name": { "type": "string", "maxLength": 40 },
    "tier": { "enum": ["basic", "plus"] }
  }
}
