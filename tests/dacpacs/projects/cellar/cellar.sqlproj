<Project Sdk="Microsoft.Build.Sql/2.3.0">
  <!-- Part of orchard's database, reached only through press. -->
  <PropertyGroup>
    <Name>cellar</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <DefaultCollation>Latin1_General_100_CI_AS</DefaultCollation>
  </PropertyGroup>
</Project>
