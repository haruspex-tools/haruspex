{
  // The generated modules again, as a Node project of ECMAScript modules compiles them ("type": "module", module and
  // moduleResolution nodenext), where an import must name the file it loads: the functions' import of their schemas
  // resolves here only with its ".js", as does a split module's import of the shared file (tests/fixtures/market).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["generated/*.ts", "generated/market/*.ts"]
}
