root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,ts,js,xml,csproj,props,targets,slnx,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Snapshots are haruspex's output byte for byte; leave them as the tests write them.
[*.{received,verified}.*]
charset = utf-8
end_of_line = lf
insert_final_newline = unset
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
csharp_prefer_braces = when_multiline
csharp_new_line_before_open_brace = all
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false

# Private fields are camelCase without a prefix.
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = camel_case
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case.capitalization = camel_case

[tests/**.cs]
# Test names read as sentences with underscores.
dotnet_diagnostic.CA1707.severity = none

[src/Haruspex.Ir/**.cs]
# The IR's vocabulary is type names (String, Int32, Object), which is exactly what CA1720 forbids.
dotnet_diagnostic.CA1720.severity = none
